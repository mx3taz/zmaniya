<section class="zm-native-page gut">
  <div class="zm-account-wrap">
    <p class="mono" style="color:var(--bone2)">ZMANIYA · CUSTOMER AREA</p>
    <h1 class="big">Your archive.</h1>
    {% if customer %}
      <p class="zm-account-intro">Welcome back, {{ customer.first_name | default: customer.name | escape }}. Your orders and account details are below.</p>
      <div class="zm-account-links">
        <a href="{{ routes.account_addresses_url }}">Manage addresses ({{ customer.addresses_count }})</a>
        <a href="{{ routes.account_logout_url }}">Log out</a>
      </div>
      <div class="zm-account-grid">
        <div class="zm-account-panel">
          <h2>Account details</h2>
          <p>{{ customer.name | escape }}</p>
          <p class="zm-account-muted">{{ customer.email | escape }}</p>
          {% if customer.phone %}<p class="zm-account-muted">{{ customer.phone | escape }}</p>{% endif %}
          {% form 'customer_update', class: 'zm-account-form' %}
            {{ form.errors | default_errors }}
            {% if form.posted_successfully %}<p class="zm-account-success" role="status">Your account details were updated.</p>{% endif %}
            <label>First name<input type="text" name="first_name" value="{{ customer.first_name | escape }}" required></label>
            <label>Last name<input type="text" name="last_name" value="{{ customer.last_name | escape }}" required></label>
            <label>Email address<input type="email" name="email" value="{{ customer.email | escape }}" required></label>
            <label>Phone<input type="tel" name="phone" value="{{ customer.phone | escape }}"></label>
            <label>Current password <span class="zm-account-muted">Required by YouCan when changing your email or password.</span><input type="password" name="current_password" autocomplete="current-password"></label>
            <button class="btn block" type="submit">Save details</button>
          {% endform %}
        </div>
        <div class="zm-account-panel">
          <h2>Order history</h2>
          {% if customer.orders_count > 0 %}
            <div class="zm-account-list">
              {% paginate customer.orders by 10 %}
                {% for order in customer.orders %}
                  <div class="zm-account-row">
                    <div>
                      <strong><a href="{{ order.customer_url }}">{{ order.name | escape }}</a></strong>
                      <small>{{ order.created_at | date: "%d %b %Y" }} · {{ order.total | money }}</small>
                    </div>
                    <div>
                      <span class="zm-account-status">{{ order.financial_status | replace: '_', ' ' }}</span>
                      {% if order.fulfillment_status %}<small>{{ order.fulfillment_status | replace: '_', ' ' }}</small>{% endif %}
                    </div>
                  </div>
                {% endfor %}
                <div class="zm-pagination">{{ paginate | default_pagination }}</div>
              {% endpaginate %}
            </div>
          {% else %}
            <p class="zm-empty">No orders yet. Your first ZMANIYA piece is waiting.</p>
            <a class="btn primary" href="{{ routes.root_url }}#collection">Explore the collection</a>
          {% endif %}
        </div>
      </div>
    {% else %}
      <div class="zm-account-panel" style="max-width:560px;margin-top:28px">
        <p>You need to log in to see your account.</p>
        <a class="btn primary" href="{{ routes.account_login_url }}">Log in</a>
      </div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "ZMANIYA customer account",
  "settings": [],
  "presets": [{ "name": "Customer account" }]
}
{% endschema %}
