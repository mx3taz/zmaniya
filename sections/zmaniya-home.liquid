{% assign white_product = section.settings.white_product %}
{% assign black_product = section.settings.black_product %}
<script>
  window.ZMANIYA_ASSET_ROOT = {{ 'logo.png' | asset_url | split: 'logo.png' | first | json }};
  window.ZMANIYA_CURRENCY = {{ store.currency.iso_code | json }};
  window.ZMANIYA_YOUCAN = {
    white: {% if white_product %}{
      "id": {{ white_product.id | json }},
      "name": {{ white_product.name | json }},
      "url": {{ white_product.url | json }},
      "price": {{ white_product.selected_or_first_available_variant.price | default: white_product.price | json }},
      "available": {{ white_product.available | json }},
      "image": {% if white_product.preview_image %}{{ white_product.preview_image.medium | json }}{% elsif white_product.thumbnail %}{{ white_product.thumbnail | json }}{% else %}null{% endif %},
      "description": {{ white_product.description | strip_html | strip | json }},
      "images": [{% for image in white_product.images %}{% unless forloop.first %},{% endunless %}{"src": {{ image.src | json }}, "alt": {{ image.alt | json }}}{% endfor %}],
      "variants": [{% for variant in white_product.variants %}{% unless forloop.first %},{% endunless %}{
        "id": {{ variant.id | json }},
        "price": {{ variant.price | json }},
        "available": {{ variant.available | json }},
        "is_selected": {{ variant.is_selected | json }},
        "variations": {{ variant.variations | json }}
      }{% endfor %}]
    }{% else %}null{% endif %},
    black: {% if black_product %}{
      "id": {{ black_product.id | json }},
      "name": {{ black_product.name | json }},
      "url": {{ black_product.url | json }},
      "price": {{ black_product.selected_or_first_available_variant.price | default: black_product.price | json }},
      "available": {{ black_product.available | json }},
      "image": {% if black_product.preview_image %}{{ black_product.preview_image.medium | json }}{% elsif black_product.thumbnail %}{{ black_product.thumbnail | json }}{% else %}null{% endif %},
      "description": {{ black_product.description | strip_html | strip | json }},
      "images": [{% for image in black_product.images %}{% unless forloop.first %},{% endunless %}{"src": {{ image.src | json }}, "alt": {{ image.alt | json }}}{% endfor %}],
      "variants": [{% for variant in black_product.variants %}{% unless forloop.first %},{% endunless %}{
        "id": {{ variant.id | json }},
        "price": {{ variant.price | json }},
        "available": {{ variant.available | json }},
        "is_selected": {{ variant.is_selected | json }},
        "variations": {{ variant.variations | json }}
      }{% endfor %}]
    }{% else %}null{% endif %}
  };
  window.ZMANIYA_INITIAL_CART = {
    "count": {{ cart.count | json }},
    "sub_total": {{ cart.sub_total | json }},
    "discounted_sub_total": {{ cart.discounted_sub_total | json }},
    "discounted_price": {{ cart.discounted_price | json }},
    "total": {{ cart.total | json }},
    "cart_submit_url": {{ cart.cart_submit_url | json }},
    "items": [{% for item in cart.items %}{% unless forloop.first %},{% endunless %}{
      "id": {{ item.id | json }},
      "product_variant_id": {{ item.product_variant_id | json }},
      "quantity": {{ item.quantity | json }},
      "price": {{ item.price | json }},
      "inventory": {{ item.inventory | json }},
      "image": {{ item.image | json }},
      "name": {{ item.name | json }},
      "variations": {{ item.variations | json }}
    }{% endfor %}]
  };
</script>

<a class="skip" href="#collection">Skip to the collection</a>

<canvas id="gl" aria-hidden="true"></canvas>
<div class="grain" aria-hidden="true"></div>
<h1 class="heromark" id="heromark" aria-label="ZMANIYA"><span><i>Z</i></span><span><i>M</i></span><span><i>A</i></span><span><i>N</i></span><span><i>I</i></span><span><i>Y</i></span><span><i>A</i></span></h1>

<main id="top">
<section id="story" aria-label="The ZMANIYA era">
  <div class="stage" id="stage">

    <div class="poster" aria-hidden="true">
      <div class="pdial"><img src="{{ 'logo.png' | asset_url }}" alt=""></div>
      <p class="pmark">ZMANIYA</p>
      <div class="parabic">زمنية</div>
    </div>

    <div class="layer l-hero" data-a="-1" data-b="0.1" data-f="0.03">
      <div class="hero-top mono"><span>Independent · Tunisia</span><span id="clock" aria-hidden="true">--:--:--</span></div>
      <div class="hero-ar ar" aria-hidden="true">زمنية</div>
      <div class="hero-row gut">
        <div class="slogan">Not a trend. <span>An era.</span></div>
        <div class="ctas">
          <a class="btn primary" href="#collection" data-go>Shop the collection</a>
          <a class="btn" href="#chap-time" data-step="1">Enter the era</a>
        </div>
        <div class="scrollcue mono" aria-hidden="true"><span>Scroll</span><i></i></div>
      </div>
    </div>

    <div class="layer l-chap gut" id="chap-time" data-a="0.14" data-b="0.32" data-f="0.035">
      <div class="chap">
        <div class="eyebrow mono"><span>I — Time</span><span class="ar" aria-hidden="true">زمن</span></div>
        <h2 class="h">Trends expire.<br><em>Eras</em> leave something behind.</h2>
        <p>Fashion trends come and go. An era stays in the people who lived it. ZMANIYA is made for that difference.</p>
      </div>
    </div>

    <div class="layer l-chap gut" data-a="0.34" data-b="0.52" data-f="0.035">
      <div class="chap">
        <div class="eyebrow mono"><span>II — Memories</span></div>
        <h2 class="h">Memories, <em>made wearable.</em></h2>
        <p>A generation, an era, a set of memories turned into something you put on. A face, a flag, a stone street, a jar of harissa. The pieces carry them.</p>
      </div>
    </div>

    <div class="layer l-chap gut" data-a="0.54" data-b="0.72" data-f="0.035">
      <div class="chap">
        <div class="eyebrow mono"><span>III — Archive</span></div>
        <h2 class="h">Kept in the <em>archive.</em></h2>
        <p>Every detail is catalogued, from the print to the label.</p>
        <ul class="specimens mono" aria-label="Catalogued details">
          <li><b>Chest print</b><span>Harissa</span></li>
          <li><b>Seal</b><span>Tunisian by blood</span></li>
          <li><b>Woven label</b><span>Hem</span></li>
          <li><b>Drawcord</b><span>Metal tips</span></li>
          <li><b>Interior</b><span>Soft fleece</span></li>
        </ul>
      </div>
    </div>

    <div class="layer l-chap gut" data-a="0.74" data-b="0.91" data-f="0.035">
      <div class="chap">
        <div class="eyebrow mono"><span>IV — Identity</span><span class="ar" aria-hidden="true">هوية</span></div>
        <h2 class="h">Tunisian <em>soul.</em><br>Palestinian <em>heart.</em><br>Global <em>voice.</em></h2>
        <p class="cap mono">As printed on the chest of the white hoodie</p>
      </div>
    </div>

    <div class="layer l-chap l-gate gut" data-a="0.93" data-b="2" data-f="0.03">
      <div class="chap">
        <div class="eyebrow mono"><span>V — Collection</span></div>
        <h2 class="h">The doors <em>are open.</em></h2>
        <p>One hoodie in two colorways. Front, back, sides and details, exactly as printed.</p>
        <div class="ctas"><a class="btn primary" href="#collection" data-go>View the collection</a></div>
      </div>
    </div>

    <div class="railwrap">
      <div class="count mono" aria-hidden="true"><b id="cNow">01</b><span>/ 06</span></div>
      <ol class="rail mono" id="rail" aria-label="Story chapters">
        <li><button type="button" data-s="0" aria-label="Opening"><span class="t">Opening</span>0</button></li>
        <li><button type="button" data-s="1" aria-label="Chapter I, Time"><span class="t">Time</span>I</button></li>
        <li><button type="button" data-s="2" aria-label="Chapter II, Memories"><span class="t">Memories</span>II</button></li>
        <li><button type="button" data-s="3" aria-label="Chapter III, Archive"><span class="t">Archive</span>III</button></li>
        <li><button type="button" data-s="4" aria-label="Chapter IV, Identity"><span class="t">Identity</span>IV</button></li>
        <li><button type="button" data-s="5" aria-label="Chapter V, Collection"><span class="t">Collection</span>V</button></li>
      </ol>
    </div>
    <a class="skipintro mono" href="#collection" data-go>Skip to the collection ↓</a>
    <div class="nextcue mono on" id="nextcue" data-s="0" aria-hidden="true"><span id="cueTxt">Scroll</span><i></i></div>
    <div class="prog" id="prog"></div>
  </div>
</section>

<div class="ticker" aria-hidden="true"><div class="track" id="ticker1"></div></div>

<section id="collection" class="block gut" aria-labelledby="colh">
  <div class="shop-head">
    <h2 class="big" id="colh"><small>Archive · Hoodies · 2 pieces</small>The collection</h2>
    <div class="filters" role="group" aria-label="Filter by colorway">
      <button class="chip" type="button" data-f="all" aria-pressed="true">All</button>
      <button class="chip" type="button" data-f="white" aria-pressed="false">White</button>
      <button class="chip" type="button" data-f="black" aria-pressed="false">Black</button>
    </div>
  </div>
  <div class="grid" id="grid"></div>
  <p class="shopnote mono" id="shopnote">Select the White and Black hoodie products in the YouCan theme editor. Prices and available sizes will then come directly from your store.</p>
</section>

<section id="lookbook" class="block" aria-labelledby="lbh">
  <div class="outline-marq" aria-hidden="true"><div class="track" id="marq"></div></div>
  <div class="gut">
    <h2 class="vh" id="lbh">Lookbook</h2>
    <p class="lead">Expression is how the piece is worn. Streets, stone walls, a Tunisian flag in the background.</p>
  </div>
  <div class="strip gut" tabindex="0" aria-label="Lookbook photographs, scroll sideways">
    <figure class="fig"><img src="{{ 'w-life2.jpg' | asset_url }}" alt="Person seen from behind in the white hoodie, back print visible, Tunisian flag in the background" loading="lazy"><figcaption class="mono">Fig. 1 · White · Back</figcaption></figure>
    <figure class="fig"><img src="{{ 'k-life1.jpg' | asset_url }}" alt="Person in the black hoodie seen from behind in front of a stone wall" loading="lazy"><figcaption class="mono">Fig. 2 · Black · Back</figcaption></figure>
    <figure class="fig"><img src="{{ 'w-life1.jpg' | asset_url }}" alt="Person in the white hoodie with the hood up, head down, hands in the pocket" loading="lazy"><figcaption class="mono">Fig. 3 · White · Front</figcaption></figure>
    <figure class="fig"><img src="{{ 'k-life2.jpg' | asset_url }}" alt="Person standing in the black hoodie and black cargo trousers" loading="lazy"><figcaption class="mono">Fig. 4 · Black · Front</figcaption></figure>
    <figure class="fig"><img src="{{ 'w-life3.jpg' | asset_url }}" alt="Side view of the white hoodie showing the sleeve print" loading="lazy"><figcaption class="mono">Fig. 5 · White · Sleeve</figcaption></figure>
  </div>
</section>
</main>

<footer class="gut">
  <div class="next">
    <h2>The next era <em>has its own graphics.</em><br>The name stays.</h2>
    <div class="sigil" aria-hidden="true"><img src="{{ 'logo.png' | asset_url }}" alt=""></div>
  </div>
  <div class="fmeta mono">
    <span>ZMANIYA · زمنية</span>
    <span>Tunisia <span id="clock2">--:--:--</span></span>
    <a href="#top" data-go>Back to top ↑</a>
  </div>
</footer>

<div class="veil" id="veil"></div>

<div id="pdp" role="dialog" aria-modal="true" aria-label="Product" data-lenis-prevent>
  <button class="xbtn" id="pdpClose" type="button" aria-label="Close product">✕</button>
  <div class="pdp-in gut" id="pdpIn"></div>
</div>

<aside id="cart" role="dialog" aria-modal="true" aria-label="Shopping cart">
  <div class="ch"><h2 id="cartTitle">Cart</h2><button class="cx" id="cartClose" type="button" aria-label="Close cart">✕</button></div>
  <div class="cbody" id="cartBody" data-lenis-prevent></div>
  <div class="cfoot" id="cartFoot"></div>
</aside>


<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
<script src="{{ 'zmaniya-home.js' | asset_url }}"></script>

{% schema %}
{
  "name": "ZMANIYA cinematic home",
  "tag": "section",
  "class": "zmaniya-home-section",
  "settings": [
    { "type": "product", "id": "white_product", "label": "White hoodie product" },
    { "type": "product", "id": "black_product", "label": "Black hoodie product" }
  ],
  "presets": [
    { "name": "ZMANIYA cinematic home" }
  ]
}
{% endschema %}
