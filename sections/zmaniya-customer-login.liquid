<section class="zm-native-page gut">
  <div class="zm-account-wrap">
    <p class="mono" style="color:var(--bone2)">ZMANIYA · CUSTOMER AREA</p>
    <h1 class="big">Your account.</h1>
    <p class="zm-account-intro">Sign in to review your orders and manage your details.</p>
    {% if customer %}
      <div class="zm-account-panel" style="max-width:560px;margin-top:28px">
        <h2>Already signed in</h2>
        <p>Welcome back, {{ customer.first_name | escape }}.</p>
        <a class="btn primary" href="{{ routes.account_url }}">Open your account</a>
      </div>
    {% else %}
      <div class="zm-account-grid">
        <div class="zm-account-panel">
          <h2>Log in</h2>
          {% form 'customer_login', return_to: routes.account_url, class: 'zm-account-form' %}
            {{ form.errors | default_errors }}
            <label>Email address<input type="email" name="email" value="{{ form.email | escape }}" autocomplete="email" required></label>
            <label>Password<input type="password" name="password" autocomplete="current-password" required></label>
            <label class="zm-account-inline"><input type="checkbox" name="remember" value="1"> Keep me signed in</label>
            <button class="btn primary block" type="submit">Log in</button>
          {% endform %}
          <p class="zm-account-muted"><a href="{{ routes.account_recover_url }}">Forgot your password?</a></p>
        </div>
        <div class="zm-account-panel">
          <h2>Recover password</h2>
          <p class="zm-account-muted">Enter the email address linked to your account. If an account exists, YouCan will send a reset link.</p>
          {% form 'recover_customer_password', class: 'zm-account-form' %}
            {% if form.posted_successfully %}<p class="zm-account-success" role="status">If an account exists for this email, a reset message has been sent.</p>{% endif %}
            {{ form.errors | default_errors }}
            <label>Email address<input type="email" name="email" value="{{ form.email | escape }}" autocomplete="email" required></label>
            <button class="btn block" type="submit">Send reset link</button>
          {% endform %}
          <div class="zm-account-links"><a href="{{ routes.account_register_url }}">Create an account</a></div>
        </div>
      </div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "ZMANIYA customer login",
  "settings": [],
  "presets": [{ "name": "Customer login" }]
}
{% endschema %}
