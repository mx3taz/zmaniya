<section class="zm-native-page gut">
  <div class="zm-account-wrap" style="max-width:620px">
    <p class="mono" style="color:var(--bone2)">ZMANIYA · CUSTOMER AREA</p>
    <h1 class="big">Set a new password.</h1>
    <div class="zm-account-panel" style="margin-top:28px">
      {% form 'reset_customer_password', class: 'zm-account-form' %}
        {{ form.errors | default_errors }}
        <label>New password<input type="password" name="password" autocomplete="new-password" minlength="6" required></label>
        <label>Confirm new password<input type="password" name="password_confirmation" autocomplete="new-password" minlength="6" required></label>
        <button class="btn primary block" type="submit">Save new password</button>
      {% endform %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "ZMANIYA password reset",
  "settings": [],
  "presets": [{ "name": "Password reset" }]
}
{% endschema %}
